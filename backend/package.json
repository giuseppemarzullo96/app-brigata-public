{
  "name": "labrigata-backend",
  "version": "1.0.0",
  "description": "Backend sistema gestionale La Brigata ODV",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup": "node src/database/setup.js",
    "configure-env": "node src/database/configure-env.js",
    "migrate": "node src/database/run-migration.js",
    "seed": "node src/database/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand"
  },
  "keywords": [
    "volontariato",
    "gestionale",
    "associazione"
  ],
  "author": "La Brigata ODV",
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/node": "^10.75.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "passkit-generator": "^3.6.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/controllers/votazioni.controller.js",
      "src/utils/scrutinio.js",
      "src/utils/verbaleVotazione.js",
      "src/utils/impostazioni.js",
      "src/controllers/impostazioni.controller.js"
    ],
    "maxWorkers": 1
  }
}
